# Copy to ignored .env and fill in LOCAL-ONLY credentials. Never use AWS credentials.
# Compose reads --env-file; Java reads exported variables (it does not parse .env).
BRONZE_S3_ENDPOINT=http://127.0.0.1:8333
BRONZE_S3_REGION=us-east-1
BRONZE_S3_BUCKET=content-lake
BRONZE_S3_ACCESS_KEY=
BRONZE_S3_SECRET_KEY=
# Optional reproducible integration run identifier: UUID. Reuse only for restart read-back.
# BRONZE_IT_ID=
# BRONZE_IT_READ_ONLY=true

# E5 B1: LOCAL PostgreSQL only. Initialization variables apply ONLY to a new volume.
# Reuse the existing installation UUID across restarts; never regenerate to bypass a mismatch.
DDIP_DB_NAME=ddip
DDIP_DB_PORT=5432
DDIP_DB_USER=
DDIP_DB_PASSWORD=
DDIP_DB_URL=jdbc:postgresql://127.0.0.1:5432/ddip
DDIP_INSTALLATION_ID=
# Required only for the idle worker role; absolute paths, not submitted commands.
DDIP_WORKER_PYTHON=
DDIP_WORKER_JAVA_HOME=
DDIP_WORKER_PROCESSING_ROOT=
# Default analytics role needs none of the database/runtime variables above.
# Never use `docker compose down -v`; retain both named volumes and inspect mismatches.

# E5 B2a: api role only. Blank catalog means no new source references are approved.
# Server-owned absolute path to a reviewed <=64 KiB catalog; never an HTTP upload.
DDIP_MANAGEMENT_CATALOG=
# Defaults to API origin. Add explicit Vite dev/preview origins when using its same-origin proxy.
DDIP_MANAGEMENT_ORIGINS=http://127.0.0.1:8080
# Optional base64url-encoded 32-byte random key. Retain privately for cursors across restarts.
# Blank uses a process-local random key: existing cursors expire on restart; source state persists.
DDIP_MANAGEMENT_CURSOR_KEY=
