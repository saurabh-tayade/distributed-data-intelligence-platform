{
  "name": "content-intelligence-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
